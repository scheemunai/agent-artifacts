# Agent Artifacts configuration.
# Copy to .env for local self-host overrides. Variables are read once at boot.

# cloud | self-hosted. Self-hosted is the zero-dependency default.
DEPLOYMENT=self-hosted

# HTTP listen port inside the process/container.
PORT=3000

# Canonical public origin for generated share URLs, magic links, OG tags, and install prompts.
# No trailing slash. Use https:// in production.
BASE_URL=http://localhost:3000

# Postgres connection string. Leave unset to use SQLite at AA_SQLITE_PATH.
# DATABASE_URL=postgres://agent_artifacts:agent_artifacts@postgres:5432/agent_artifacts

# SQLite file path. Docker uses /data so the named volume persists it.
AA_SQLITE_PATH=./data/agent-artifacts.db

# HMAC key for sessions and share tokens.
# Cloud requires this. Self-host auto-generates <datadir>/.session-secret with mode 0600.
# SESSION_SECRET=

# Optional private cloud extension module; not needed for self-hosted OSS.
# AA_CLOUD_MODULE=@agentartifact/cloud

# Self-host only: hide the public-page "Made with ◆ Agent Artifacts" footer.
AA_HIDE_FOOTER=false

# ---------------------------------------------------------------------------
# Billing (Stripe). Hosted-cloud only, and OFF unless deliberately enabled.
#
# Leaving AA_BILLING_ENABLED unset means: no pricing CTA, no /stripe/webhook
# route, no Stripe customers, no Stripe SDK in the boot path. That is what a
# self-host and a developer's laptop should be.
#
# Turning it ON requires ALL FOUR of the STRIPE_* values below. A half-configured
# billing system boots an instance whose upgrade button leads somewhere broken,
# so the process refuses to start instead. Boot also fails if the key's mode and
# the deployment's mode disagree — a test key on a production BASE_URL, or a live
# key anywhere else.
# AA_BILLING_ENABLED=false

# Create the Product and Prices (re-runnable, idempotent):
#   STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-setup-products.mjs
# It prints the two price ids to paste below.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...

# Signing secret for POST /stripe/webhook. PER ENDPOINT: the value `stripe listen`
# prints is for local development and is NOT the deployed endpoint's secret.
#   stripe listen --forward-to localhost:3000/stripe/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...

# Arms the DESTRUCTIVE half of the free-tier retention sweep (7-day window).
#
# Read this before setting it to true. Until paid plans existed every plan had
# unlimited retention, so the sweep never deleted anything. Giving the free tier
# a 7-day window is what arms it, and the first sweep afterwards soft-deletes
# every free artifact older than a week and revokes its share links — including
# links people have already sent to other people.
#
# With this OFF (the default) the sweep still runs and logs exactly what it would
# have removed, as `billing.retention.dry_run` with a `would_soft_delete` count.
# Look at that number on real data before you turn this on. Accounts that existed
# when billing landed are grandfathered to unlimited retention regardless.
# AA_RETENTION_ENFORCEMENT_ENABLED=false

# Optional dedicated origin for sandboxed HTML artifacts.
# Cloud requires a separate sandbox origin; self-host can leave unset.
# SANDBOX_ORIGIN=https://usercontent.example.com

# SMTP mail adapter for magic links / notifications. Self-host can leave unset for password auth only.
# If any SMTP_* setting is set, SMTP_FROM must also be set.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Agent Artifacts <no-reply@example.com>

# Mail transport override: smtp | resend | log.
# Leave unset for auto-detect: RESEND_API_KEY -> Resend, else complete SMTP
# (SMTP_HOST + SMTP_FROM) -> SMTP, else no mail. In cloud mode, no detected
# mail transport is a fatal boot error.
# `log` is development only: no email is delivered and login links are written
# to the app log. Never use it in production.
# AA_MAIL_TRANSPORT=

# Resend mail adapter. Takes precedence over SMTP when auto-detecting.
# RESEND_API_KEY=

# Rate limits.
AA_RATE_LIMIT_RPM=60
AA_RATE_LIMIT_WRITES_PER_MIN=10
AA_RATE_LIMITS_DISABLED=false
AA_TRUST_PROXY=0

# Payload and retention controls.
AA_MAX_CONTENT_BYTES=2097152
AA_ARTIFACT_PURGE_DAYS=30

# Public repository URL, shown on the cloud marketing homepage.
# Leave unset until the repository is published (see docs/decisions.md,
# "Repository publication status"). While it is unset the homepage renders no
# GitHub link, button, or star prompt instead of linking to a URL that 404s.
# AA_GITHUB_URL=https://github.com/<owner>/agent-artifacts

# Share path of the artifact the marketing homepage links to and polls for its
# "live artifact" state. An artifact id is a row in one database, so the default
# only exists on the instance it was seeded on — point this at your own share, or
# set it EMPTY to say this host has no hero artifact. Empty is a value, not an
# absence: it removes the homepage link and stops the background poller instead
# of falling back to the default (which is a 404 anywhere else).
# AA_HERO_ARTIFACT_PATH=/a/YourShareId

# DataFast analytics. The site id is PUBLIC — it is rendered into every visitor's
# HTML — but it is deliberately unset here so development and self-hosting stay
# off: empty or unset means no script tag and no analytics host in the CSP. The
# reported domain is derived from BASE_URL, so it is always the host you serve.
# AA_DATAFAST_SITE_ID=dfid_yourSiteId

# Public contacts.
AA_ABUSE_EMAIL=abuse@agentartifact.ai
AA_SECURITY_EMAIL=security@agentartifact.ai

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
