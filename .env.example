# Agent Artifacts configuration (mirrors PRD §6)

# cloud | self-hosted. self-hosted is the zero-dependency default.
DEPLOYMENT=self-hosted

# HTTP listen port.
PORT=3000

# Canonical origin for generated URLs. No trailing slash.
BASE_URL=http://localhost:3000

# Postgres connection string. Leave unset to use SQLite at AA_SQLITE_PATH.
# DATABASE_URL=postgres://agent_artifacts:agent_artifacts@postgres:5432/agent_artifacts

# SQLite database path (ignored when DATABASE_URL is set).
AA_SQLITE_PATH=./data/agent-artifacts.db

# Cloud requires this. Self-host auto-generates <datadir>/.session-secret mode 0600 when unset.
# SESSION_SECRET=

# Cloud package module specifier (cloud deployments only, loaded in a later milestone).
# AA_CLOUD_MODULE=@agentartifact/cloud

# Self-host only: hide the public-page footer.
AA_HIDE_FOOTER=false

# Cloud requires a separate sandbox origin. Self-host can leave unset for same-host sandboxing.
# SANDBOX_ORIGIN=https://usercontent.agentartifact.ai

# SMTP mail adapter. Self-host can leave unset for password auth only.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Agent Artifacts <no-reply@agentartifact.ai>

# Resend mail adapter. Takes precedence over SMTP when set.
# RESEND_API_KEY=

# API rate-limit overrides.
AA_RATE_LIMIT_RPM=60
AA_RATE_LIMIT_WRITES_PER_MIN=10
AA_RATE_LIMITS_DISABLED=false
AA_TRUST_PROXY=0

# Artifact payload and purge controls.
AA_MAX_CONTENT_BYTES=2097152
AA_ARTIFACT_PURGE_DAYS=30

# Public/security contacts.
AA_ABUSE_EMAIL=abuse@agentartifact.ai
AA_SECURITY_EMAIL=security@agentartifact.ai

# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info
