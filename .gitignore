# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
coverage/
.scratch/
# Generated by `pnpm run build:css` from src/ui/assets/app.css. Not committed: the Tailwind output
# is content-hashed over the whole scanned source tree, so committing it would churn on unrelated
# UI edits. `pnpm dev`, `pnpm build` and the Docker build all run the CSS build first, and
# src/ui/assets.ts fails loudly (public/assets/build-missing.css) if it somehow has not.
public/assets/app-*.css
public/assets/manifest.json

# Runtime state / secrets
.env
.env.*
!.env.example
data/
*.log
ecosystem.config.cjs

# OS / editors
.DS_Store
.idea/
.vscode/

# Playwright
playwright-report/
test-results/
blob-report/
