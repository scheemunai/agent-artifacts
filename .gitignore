# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
coverage/
.scratch/
# Hashed runtime assets, produced from src/ by `pnpm run build:assets`. Not committed: the name of
# each file is a content hash, and a checked-in hash goes stale the moment someone edits the source
# — which is exactly how three of these shipped for months under names that no longer described
# their contents. `pnpm dev`, `pnpm test`, `pnpm build` and the Docker build all run the build
# first, and src/ui/assets.ts fails loudly if it somehow has not.
public/assets/app-*.css
public/assets/ui-foundation-*.js
public/assets/viewer-*.js
public/assets/viewer-*.css
public/assets/dashboard-*.js
public/assets/manifest.json

# Runtime state / secrets
.env
.env.*
!.env.example
data/
*.log
ecosystem.config.cjs

# OS / editors
.DS_Store
.idea/
.vscode/

# Playwright
playwright-report/
test-results/
blob-report/
