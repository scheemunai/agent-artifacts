{
  "name": "agent-artifacts",
  "version": "0.1.0",
  "description": "Agent-first artifact publishing service for versioned, shareable markdown and HTML pages.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm run build:css && tsc -p tsconfig.build.json",
    "build:css": "mkdir -p .scratch && tailwindcss -i ./src/ui/assets/app.css -o ./.scratch/app.css --minify && node scripts/hash-css.mjs ./.scratch/app.css",
    "typecheck": "tsc --noEmit",
    "check": "biome ci . && pnpm run typecheck",
    "test": "vitest run",
    "db:generate": "pnpm run db:generate:sqlite && pnpm run db:generate:postgres",
    "db:generate:sqlite": "drizzle-kit generate --dialect sqlite --schema ./src/db/schema.sqlite.ts --out ./drizzle/sqlite --name init",
    "db:generate:postgres": "drizzle-kit generate --dialect postgresql --schema ./src/db/schema.postgres.ts --out ./drizzle/postgres --name init",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test:postgres": "vitest run tests/integration/postgres-dialect.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/nodemailer": "8.0.1",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.4",
    "isomorphic-dompurify": "3.23.0",
    "marked": "18.0.11",
    "nanoid": "6.0.1",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "satori": "0.33.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/cli": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
